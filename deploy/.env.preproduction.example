# Variables del ambiente de PREPRODUCCIÓN de Arkana Cards.
# Se copia a /srv/arkana/shared/.env en el servidor; nunca se guarda con valores reales en Git.
APP_NAME="Arkana Cards (Preproducción)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://preprod.arkana.local

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=7

# Base de datos de preproducción independiente (SQLite en la práctica;
# en un servidor real puede ser MySQL arkana_preprod con su propio usuario).
DB_CONNECTION=sqlite
DB_DATABASE=/srv/arkana/shared/database/preprod.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=arkana_preprod
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
